rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to participants collection since the app uses custom/local authentication
    match /participants/{participantId} {
      allow read: if true;
      allow create: if request.resource.data.id == participantId
                    && request.resource.data.userInfo.grade is string
                    && request.resource.data.userInfo.classGroup is string
                    && request.resource.data.userInfo.number is string
                    && request.resource.data.userInfo.name is string;
      allow update: if request.resource.data.id == participantId;
      allow delete: if true;
    }
  }
}
